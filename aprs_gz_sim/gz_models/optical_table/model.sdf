<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="optical_table">
    <static>true</static>

    <link name="optical_table_link">

      <visual name="optical_table_visual">
        <!-- <pose>-0.1000125 0.320675 0.422275 0 0 0 </pose> -->
        <!-- <pose>-0.1000125 0.320675 0 0 0 1.5708 </pose> -->
        <!-- Pose removed as it is now defined in the world file -->
        <geometry>
          <box>
            <size> 2.4384 1.2192 0.85 </size>
          </box>
          <!-- <mesh>
            <uri>model://optical_table/meshes/New_Motoman_Table.stl</uri>
          </mesh> -->
        </geometry>
        <material>
          <ambient>0.0 0.0 0.0 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>

      <collision name="optical_table_collision">
        <!-- Pose removed as it is now defined in the world file -->
        <geometry>
          <box>
            <size> 2.4384 1.2192 0.84455 </size>
          </box>
          <!-- <mesh>
            <uri>model://optical_table/meshes/New_Motoman_Table.stl</uri>
          </mesh> -->
        </geometry>
      </collision>

    </link>

    <link name="corner_link">
      <pose>-1.1792 -0.5696 0.425 0 0 0</pose>
    </link>

    <plugin
      filename="libTFPublisherPlugin.so"
      name="aprs_plugins::TFPublisherPlugin">
      <base_link>optical_table_link</base_link>
      <static>true</static>
      <child link="corner_link" frame="corner_frame"/>
      
    </plugin>
  </model>
</sdf>